{
  "name": "person-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 PI SDK 的本地优先 Agent 平台",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:pi-imports": "node scripts/verify-pi-sdk-imports.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run check:pi-imports && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@hono/node-server": "2.0.11",
    "better-sqlite3": "12.11.1",
    "hono": "4.12.31",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
