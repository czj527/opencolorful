{
  "name": "opencolorful",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "desktop",
    "web",
    "packages/*"
  ],
  "description": "OpenColorful — 本地优先的个人助理 Agent 平台与个人效率工作台",
  "bin": {
    "ocf": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:protocol": "npm run build -w @opencolorful/plugin-protocol",
    "build:sdk": "npm run build -w @opencolorful/plugin-sdk && npm run build -w @opencolorful/plugin-runtime && npm run build -w @opencolorful/plugin-components",
    "check:docs": "node scripts/verify-document-governance.mjs",
    "architecture:map": "node scripts/generate-architecture-map.mjs",
    "architecture:check": "node scripts/generate-architecture-map.mjs --check",
    "check:pi-imports": "node scripts/verify-pi-sdk-imports.mjs",
    "check:plugin-imports": "node scripts/verify-plugin-imports.mjs",
    "check:skill-package": "node scripts/verify-skill-package.mjs examples/skills/sdk-showcase-skill",
    "cli": "tsx src/cli/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run check:docs && npm run architecture:check && npm run check:pi-imports && npm run check:plugin-imports && npm run build:protocol && npm run build:sdk && npm run typecheck && npm run test && npm run build && npm run web:test && npm run web:build && npm run desktop:test && npm run desktop:build",
    "desktop:dev": "npm run dev --workspace=@opencolorful/desktop",
    "desktop:build": "npm run build --workspace=@opencolorful/desktop",
    "desktop:start": "npm run start --workspace=@opencolorful/desktop",
    "desktop:pack": "npm run build:protocol && npm run build:sdk && npm run build && npm run pack --workspace=@opencolorful/desktop",
    "web:dev": "npm run dev --workspace=web",
    "web:build": "npm run build --workspace=web",
    "web:test": "npm run test --workspace=web",
    "test:skills-live": "vitest run --config vitest.live.config.ts",
    "desktop:test": "npm run test --workspace=@opencolorful/desktop"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@hono/node-server": "2.0.11",
    "@hono/node-ws": "1.3.1",
    "better-sqlite3": "12.11.1",
    "hono": "4.12.31",
    "typebox": "1.3.6",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
