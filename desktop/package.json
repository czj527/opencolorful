{
  "name": "@opencolorful/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit && vite build",
    "start": "electron electron/main.cjs",
    "stage": "node scripts/stage-release.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "test": "vitest run",
    "pack": "npm run build && npm run stage && npm run rebuild:native && electron-builder --config electron-builder.yml --win --x64 --publish never && npm run verify:pack"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.33.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "37.10.3",
    "electron-builder": "^26.8.1",
    "happy-dom": "^18.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
